# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/event_management
# Used only by the automated tests (a separate database that gets wiped)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/event_management_test
# Use a long random string (32+ characters) node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=31a7045b44f23d63005030b8fd69daceab7a1d5cb92aa48524c73f0a445bb88d
JWT_EXPIRES_IN=2h
# Registering with this code creates an Admin account; without it the account is a Participant
ADMIN_SIGNUP_CODE=ADMIN-2026
# Browser origin allowed to call the API directly (the Docker/proxy setup is same-origin)
CORS_ORIGIN=http://localhost:4200
